{
  "name": "riss-v",
  "version": "0.1.1",
  "description": "A JS implementation of the RISC-V specification.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inbestigator/risc.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./32I": "./dist/32I/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "checks": "tsc --noEmit && biome check --write",
    "dist": "rm -fr dist && tsc",
    "dry-publish": "bun publish --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
